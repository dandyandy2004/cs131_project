# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit your real credentials.

# Path to your Google service account JSON key (relative to edge_dev3/, or absolute)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ID of the Drive folder you shared with the service account email
DRIVE_FOLDER_ID=replace_with_your_folder_id

# Optional: webcam index (default 0)
CAMERA_INDEX=0

# Optional: max number of snapshots per run (default 2: one ENTER + one LEAVE)
MAX_SNAPSHOTS=2
