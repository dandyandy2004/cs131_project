# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit your real credentials.

# --- LOCAL TEST MODE ---
# Set to 1 to bypass Firebase and write events to a local SQLite file
# (used by the Streamlit dashboard in dashboard/). Default 0.
LOCAL_MODE=0

# Optional override for the SQLite file path (default: <repo>/local_data/events.db)
# LOCAL_DB_PATH=/abs/path/to/events.db

# --- FIREBASE (used when LOCAL_MODE=0) ---
# Path to your Firebase service account JSON key
FIREBASE_CREDENTIALS=firebase_credentials.json

# Cloud Storage bucket name (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=replace_with_your_bucket_name

# --- COMMON ---
# Device identifier written into each event
DEVICE_ID=edge_dev3

# Optional: webcam index (default 0)
CAMERA_INDEX=0
