rules_version = '2';

// Public read on detection events; the service account writes via the
// Admin SDK, which bypasses these rules. No client-side writes allowed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /combined_status/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /combined_alerts/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
