# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# Same Firebase project the edge devices write to
FIREBASE_CREDENTIALS=firebase_credentials.json
FIREBASE_STORAGE_BUCKET=replace_with_your_bucket_name

# GPIO pin numbers (BOARD mode) for the LED indicator
# Adjust to match your physical wiring on the Jetson Nano
LED_RED_PIN=11
LED_GREEN_PIN=13
