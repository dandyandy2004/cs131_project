# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit your real credentials.

# Path to your Firebase service account JSON key
FIREBASE_CREDENTIALS=firebase_credentials.json

# Cloud Storage bucket name (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=replace_with_your_bucket_name

# Device identifier written into each Firestore event
DEVICE_ID=edge_dev1

# Optional: webcam index (default 0)
CAMERA_INDEX=1

# Optional: run YOLO every N captured frames (default 3)
INFER_EVERY=3
